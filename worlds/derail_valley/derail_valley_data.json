    {
      "groupName": "Shunting job",
      "offset": "0x2000",
      "rule": "can_operate_one_loco & Has('Shunting license') & Has(\"${name}.split(' ')[0] Station unlock\")",
      "map_offset": "0x100",
      "repeat_n": 10,
      "objects": [{"name": "$(stations) shunting order ${n+1}"}]
    },
    {
      "groupName": "Transport job",
      "offset": "0x4000",
      "rule": "can_operate_one_loco & transport_job & Has(\"${name}.split(' ')[0] Station unlock\")",
      "map_offset": "0x100",
      "repeat_n": 10,
      "objects": [{"name": "$(stations) transport order ${n+1}"}]
    },
    {
      "groupName": "Loco completed orders",
      "offset": "0x600",
      "rule": "can_operate(${name}.split(' ')[0]) & can_make_money",
      "objects": [{"name": "$(loco) orders completed"}]
    },
    {
      "groupName": "Relic parts to museum",
      "offset": "0x620",
      "rule": "can_make_money & HasAll('Museum license', \"Demo locomotive ${name}.split(' ')[0]\")",
      "objects": [{"name": "$(loco) relic parts to museum"}]
    },
    {
      "groupName": "Relic painted",
      "offset": "0x630",
      "rule": "can_make_money & HasAllCounts({\"${name}.split(' ')[0] locomotive license\":1, \"Paint Sprayer\":1, \"Manual service license\":1, \"Museum license\":1, \"Demo locomotive ${name}.split(' ')[0]\": 2}",
      "objects": [{"name": "$(loco) relic painted"}]
    },
